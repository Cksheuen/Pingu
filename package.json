{
  "name": "pingu-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:portal": "pnpm --dir apps/portal dev",
    "dev:eva-blog": "pnpm --dir apps/eva-blog dev",
    "dev:eva-blog-admin": "pnpm --dir apps/eva-blog-admin dev",
    "dev:eva-blog-status": "pnpm --dir apps/eva-blog-status dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --dir apps/desktop build",
    "build:portal": "pnpm --dir apps/portal build",
    "build:eva-blog": "pnpm --dir apps/eva-blog build",
    "build:eva-blog-admin": "pnpm --dir apps/eva-blog-admin build",
    "build:eva-blog-status": "pnpm --dir apps/eva-blog-status build",
    "test:eva-blog": "pnpm --dir apps/eva-blog test",
    "test:eva-blog-admin": "pnpm --dir apps/eva-blog-admin test",
    "verify:eva-blog": "pnpm --dir apps/eva-blog verify",
    "verify:eva-blog-admin": "pnpm --dir apps/eva-blog-admin verify",
    "test:eva-blog-status": "pnpm --dir apps/eva-blog-status test",
    "verify:eva-blog-status": "pnpm --dir apps/eva-blog-status verify",
    "tauri": "pnpm --dir apps/desktop tauri",
    "test:desktop": "pnpm --dir apps/desktop test:functional:ts",
    "check:vps": "python3 -m compileall -q ops/vps",
    "test:gate": "python3 -m unittest ops.vps.test_pingu_gate",
    "test:vps": "python3 -m unittest discover -s ops/vps -p 'test_*.py'",
    "audit:vps": "bash ops/vps/audit-remote.sh",
    "debug:proxy:status": "pnpm --dir apps/desktop debug:proxy:status",
    "debug:proxy:prepare": "pnpm --dir apps/desktop debug:proxy:prepare",
    "debug:proxy:start": "pnpm --dir apps/desktop debug:proxy:start",
    "check:config": "pnpm --dir apps/desktop check:config",
    "test:routing": "pnpm --dir apps/desktop test:routing",
    "verify:routing": "pnpm --dir apps/desktop verify:routing"
  }
}
