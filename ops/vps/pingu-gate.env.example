# Copy to /etc/pingu-gate.env and keep it root-owned (0600).
PINGU_GATE_PATH_PREFIX=/__pingu_gate__
PINGU_GATE_TOKEN_FILE=/etc/pingu-gate.token
PINGU_GATE_TOKENS_FILE=/etc/pingu-gate.tokens
PINGU_GATE_SUBSCRIPTION_FILE=/etc/pingu-gate.subscription.txt
PINGU_GATE_DEFAULT_TTL=7d
PINGU_GATE_LEASE_TTL=30m
PINGU_GATE_IPV6_PREFIX_BITS=128
PINGU_GATE_CERT_FILE=/usr/local/etc/xray/certs/cksheuen.site.crt
PINGU_GATE_KEY_FILE=/usr/local/etc/xray/certs/cksheuen.site.key
PINGU_GATE_WS_BACKEND_HOST=127.0.0.1
PINGU_GATE_WS_BACKEND_PORT=10000
PINGU_GATE_PORTAL_BACKEND_HOST=127.0.0.1
PINGU_GATE_PORTAL_BACKEND_PORT=10080
PINGU_GATE_DEVICE_STATE_FILE=/var/lib/pingu-gate/devices.json
PINGU_GATE_PUBLIC_ORIGIN=https://cksheuen.site
PINGU_GATE_DEVICE_WS_PREFIX=/__pingu_device__/v1
PINGU_GATE_DEVICE_SUBSCRIPTION_PREFIX=/__pingu_gate__/devices/subscription
PINGU_GATE_DEVICE_SESSION_TTL=900
PINGU_GATE_QRENCODE_BIN=/usr/bin/qrencode

# Authentication values belong in the referenced root-only files. Do not put
# bearer tokens, subscription URLs, UUIDs, or private keys in this repository.
