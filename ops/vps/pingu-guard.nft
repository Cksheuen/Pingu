table inet pingu_guard {
  set cf4 {
    type ipv4_addr
    flags interval
    auto-merge
    elements = { 173.245.48.0/20, 103.21.244.0/22, 103.22.200.0/22, 103.31.4.0/22, 141.101.64.0/18, 108.162.192.0/18, 190.93.240.0/20, 188.114.96.0/20, 197.234.240.0/22, 198.41.128.0/17, 162.158.0.0/15, 104.16.0.0/13, 104.24.0.0/14, 172.64.0.0/13, 131.0.72.0/22 }
  }

  set cf6 {
    type ipv6_addr
    flags interval
    auto-merge
    elements = { 2400:cb00::/32, 2606:4700::/32, 2803:f800::/32, 2405:b500::/32, 2405:8100::/32, 2a06:98c0::/29, 2c0f:f248::/32 }
  }

  set banned4 {
    type ipv4_addr
    flags timeout
    timeout 31d
  }

  set banned6 {
    type ipv6_addr
    flags timeout
    timeout 31d
  }

  set acct4 {
    type ipv4_addr
    flags dynamic,timeout
    timeout 31d
    counter
  }

  set acct6 {
    type ipv6_addr
    flags dynamic,timeout
    timeout 31d
    counter
  }

  # Permanent source-IP entries are intentionally empty. Devices obtain a
  # short lease through pingu-gate instead of relying on a fixed address.
  set reality_perm4 {
    type ipv4_addr
    flags interval
    auto-merge
  }

  set reality_perm6 {
    type ipv6_addr
    flags interval
    auto-merge
  }

  set reality_allow4 {
    type ipv4_addr
    flags interval,timeout
    timeout 7d
    auto-merge
  }

  set reality_allow6 {
    type ipv6_addr
    flags interval,timeout
    timeout 7d
    auto-merge
  }

  set probe4 {
    type ipv4_addr
    flags dynamic,timeout
    timeout 1d
    counter
  }

  set probe6 {
    type ipv6_addr
    flags dynamic,timeout
    timeout 1d
    counter
  }

  chain input {
    type filter hook input priority -50; policy accept;

    meta nfproto ipv4 tcp dport 8443 ip saddr @banned4 counter drop
    meta nfproto ipv6 tcp dport 8443 ip6 saddr @banned6 counter drop

    meta nfproto ipv4 tcp dport 443 ip saddr @cf4 counter accept
    meta nfproto ipv6 tcp dport 443 ip6 saddr @cf6 counter accept
    tcp dport 443 counter drop

    meta nfproto ipv4 tcp dport 8443 ip saddr @reality_perm4 update @acct4 { ip saddr timeout 31d } accept
    meta nfproto ipv6 tcp dport 8443 ip6 saddr @reality_perm6 update @acct6 { ip6 saddr timeout 31d } accept
    meta nfproto ipv4 tcp dport 8443 ip saddr @reality_allow4 update @acct4 { ip saddr timeout 31d } accept
    meta nfproto ipv6 tcp dport 8443 ip6 saddr @reality_allow6 update @acct6 { ip6 saddr timeout 31d } accept
    meta nfproto ipv4 tcp dport 8443 update @probe4 { ip saddr timeout 1d } counter drop
    meta nfproto ipv6 tcp dport 8443 update @probe6 { ip6 saddr timeout 1d } counter drop
  }
}
