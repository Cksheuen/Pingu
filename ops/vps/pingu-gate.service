[Unit]
Description=Pingu gate dynamic proxy allowlist
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/pingu-gate.env
ExecStart=/usr/local/sbin/pingu-gate
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=pingu-gate
StateDirectoryMode=0700
ReadWritePaths=/run /var/lib/pingu-gate

[Install]
WantedBy=multi-user.target
