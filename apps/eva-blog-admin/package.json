{
  "name": "eva-blog-author-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Eva Blog author editor for drafting and publishing articles.",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs",
    "smoke:dev": "node scripts/smoke-dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:handoff": "node scripts/check-handoff.mjs",
    "verify": "pnpm test && pnpm build && pnpm smoke:dev && pnpm verify:handoff"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1"
}
