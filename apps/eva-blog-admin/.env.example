# GitHub OAuth for the private author API.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HMAC secret for signed HTTP-only sessions.
SESSION_SECRET=

# Only these GitHub logins may save articles, publish, or sync status.
AUTHOR_GITHUB_LOGINS=

# Credentialed status-app and OAuth callback origins.
ALLOWED_ORIGINS=http://127.0.0.1:4175
ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:4175

# Optional hosted AI provider. Empty or deterministic-fallback keeps local output stable.
AI_PROVIDER=deterministic-fallback
AI_API_KEY=

# Cloudflare binding/storage label.
BLOG_STORAGE_NAMESPACE=eva-blog-system-mvp
BLOG_DB=
OAUTH_STATE_KV=
ARTWORK_BUCKET=
