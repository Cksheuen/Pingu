{
  "name": "eva-blog-public-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public Eva Blog reader with published articles, comments, public status, and GitHub auth contract.",
  "scripts": {
    "assets": "tsx scripts/generate-assets.ts",
    "dev": "vite",
    "build": "tsx scripts/generate-assets.ts && vite build",
    "preview": "tsx scripts/dev-server.ts",
    "smoke:dev": "tsx scripts/smoke-dev-server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:handoff": "tsx scripts/check-handoff.ts",
    "verify": "pnpm test && pnpm build && pnpm smoke:dev && pnpm verify:handoff"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1"
}
