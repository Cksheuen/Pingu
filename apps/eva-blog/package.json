{
  "name": "eva-blog-public-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public Eva Blog reader with published articles, comments, public status, and GitHub auth contract.",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "dev": "vite",
    "build": "node scripts/generate-assets.mjs && vite build",
    "preview": "node scripts/dev-server.mjs",
    "smoke:dev": "node scripts/smoke-dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:handoff": "node scripts/check-handoff.mjs",
    "verify": "pnpm test && pnpm build && pnpm smoke:dev && pnpm verify:handoff"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1"
}
