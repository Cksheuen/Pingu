# GitHub OAuth for credentialed public comments.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HMAC secret for the signed HTTP-only eva_session cookie.
SESSION_SECRET=

# Comma-separated origins allowed to call this Worker with credentials.
ALLOWED_ORIGINS=
ALLOWED_REDIRECT_ORIGINS=

# Cloudflare binding/storage label.
BLOG_STORAGE_NAMESPACE=eva-blog-system-mvp
BLOG_DB=
OAUTH_STATE_KV=
ARTWORK_BUCKET=
PUBLIC_SITE_ORIGIN=https://replace-with-public-domain.example
