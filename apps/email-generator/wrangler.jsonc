{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pingu-email-generator-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "EMAIL_DOMAINS": "example.com" },
  "kv_namespaces": [{
    "binding": "TEMP_MAIL_MESSAGES",
    "id": "00000000000000000000000000000000"
  }]
}
